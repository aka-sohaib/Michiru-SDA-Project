<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  ProgressTrackingView — UC09: Track Mentorship Progress
  Mirrors the InternshipsView layout (header + scrollable card list).
  All accordion cards are built programmatically by the controller.

  Layer structure:
    StackPane (internships-root)
      └── VBox (main content)
            ├── Page header HBox
            ├── Separator
            └── ScrollPane (internship-scroll-pane, vgrow=ALWAYS)
                  └── VBox fx:id="cardContainer"  ← cards injected here
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.michiru.ProgressTrackingViewController"
           maxWidth="Infinity" maxHeight="Infinity"
           styleClass="internships-root">

    <!-- ═══════════════════════════════════════════════════════════════════
         LAYER 0 — Main content
         ═══════════════════════════════════════════════════════════════════ -->
    <VBox maxWidth="Infinity" maxHeight="Infinity" spacing="0">
        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

        <!-- Page Header -->
        <HBox alignment="CENTER_LEFT" spacing="14">

            <StackPane styleClass="page-title-icon-pill"
                       minWidth="42" minHeight="42"
                       maxWidth="42" maxHeight="42">
                <FontIcon iconLiteral="fas-route"
                          iconSize="18"
                          styleClass="page-title-icon"/>
            </StackPane>

            <VBox spacing="3">
                <Label text="Mentorship Progress"
                       styleClass="page-title"/>
                <Label fx:id="lblSubtitle"
                       text="Loading your mentorship activity…"
                       styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Count badge (top-right) -->
            <VBox alignment="CENTER" spacing="1">
                <Label fx:id="lblTotalCount"
                       text="—"
                       styleClass="assessment-skill-count-num"/>
                <Label text="total requests"
                       styleClass="assessment-skill-count-lbl"/>
            </VBox>

        </HBox>

        <!-- Divider -->
        <Separator styleClass="section-divider">
            <VBox.margin><Insets top="18" bottom="18"/></VBox.margin>
        </Separator>

        <!-- Scrollable accordion card list -->
        <ScrollPane fx:id="listScrollPane"
                    fitToWidth="true"
                    styleClass="internship-scroll-pane"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER">
            <VBox fx:id="cardContainer" spacing="10" fillWidth="true">
                <padding><Insets top="2" right="2" bottom="20" left="2"/></padding>
            </VBox>
        </ScrollPane>

    </VBox>

</StackPane>
