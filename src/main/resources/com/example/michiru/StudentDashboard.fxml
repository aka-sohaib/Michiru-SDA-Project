<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- ═══════════════════════════════════════════════════════════════════
     StudentDashboard.fxml
     Root: StackPane (dark canvas)
     ├── VBox (full-size layout spine)
     │   ├── HBox  ← TOP NAV PANE (~15%) — transparent wrapper
     │   │   ├── HBox: logo capsule (floating glass)
     │   │   ├── HBox: nav menu (6 items)  ← CENTER (hgrow=ALWAYS)
     │   │   └── HBox: logout capsule
     │   └── StackPane ← MASTER CONTENT CARD (85%) — frosted glass
     │       └── StackPane fx:id="contentArea"  ← hot-swap zone
     │           └── ScrollPane fx:id="studentHomeRoot" (student home)
═══════════════════════════════════════════════════════════════════ -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.michiru.StudentDashboardController"
           styleClass="dash-root"
           stylesheets="@michiru-styles.css">

    <!-- ═══════════════════════════════════════════════════════════
         FULL-SCREEN LAYOUT SPINE (VBox)
    ═══════════════════════════════════════════════════════════════ -->
    <VBox alignment="TOP_CENTER" spacing="0" maxWidth="Infinity" maxHeight="Infinity"
          StackPane.alignment="CENTER">

        <!-- ─────────────────────────────────────────────────────
             TOP NAVIGATION PANE (~15% vertical)
        ──────────────────────────────────────────────────────── -->
        <HBox fx:id="navPane" styleClass="nav-pane"
              alignment="CENTER" spacing="10">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <!-- ── Logo Capsule ──────────────────────────────── -->
            <HBox styleClass="nav-logo-capsule" alignment="CENTER_LEFT" spacing="10"
                  pickOnBounds="true">
                <padding>
                    <Insets top="8" right="16" bottom="8" left="12"/>
                </padding>
                <ImageView fx:id="navLogo"
                           fitWidth="30" fitHeight="30"
                           preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@images/logo.png"/></image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label text="MICHIRU" styleClass="nav-brand-name"/>
                    <Label text="満ちる" styleClass="nav-brand-kanji"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- ══ NAVIGATION MENU CAPSULE ══════════════════════ -->
            <HBox styleClass="nav-menu-capsule" alignment="CENTER" spacing="4">
                <padding>
                    <Insets top="6" right="6" bottom="6" left="6"/>
                </padding>

                <Button fx:id="btnDashboard"
                        styleClass="nav-item-btn, nav-item-active"
                        onAction="#handleNavDashboard"
                        maxWidth="Infinity"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-home" iconSize="14" styleClass="nav-icon"/>
                            <Label text="Dashboard" styleClass="nav-label" mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnSkillAssessment"
                        styleClass="nav-item-btn"
                        onAction="#handleNavSkillAssessment"
                        maxWidth="Infinity"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-pencil-alt" iconSize="14" styleClass="nav-icon"/>
                            <Label text="Skill Assessment" styleClass="nav-label" mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnReadinessCheck"
                        styleClass="nav-item-btn"
                        onAction="#handleNavReadinessCheck"
                        maxWidth="Infinity"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-chart-bar" iconSize="14" styleClass="nav-icon"/>
                            <Label text="Readiness Check" styleClass="nav-label" mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnValidationRequest"
                        styleClass="nav-item-btn"
                        onAction="#handleNavValidationRequest"
                        maxWidth="Infinity"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-check-circle" iconSize="14" styleClass="nav-icon"/>
                            <Label text="Validation Request" styleClass="nav-label" mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnFindMentor"
                        styleClass="nav-item-btn"
                        onAction="#handleNavFindMentor"
                        maxWidth="Infinity"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-users" iconSize="14" styleClass="nav-icon"/>
                            <Label text="Find Mentor" styleClass="nav-label" mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnMyProgress"
                        styleClass="nav-item-btn"
                        onAction="#handleNavMyProgress"
                        maxWidth="Infinity"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-chart-line" iconSize="14" styleClass="nav-icon"/>
                            <Label text="My Progress" styleClass="nav-label" mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>

            </HBox>
            <!-- ══ END NAV MENU CAPSULE ══════════════════════════ -->

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnLogout"
                    styleClass="nav-logout-btn"
                    onAction="#handleLogout"
                    mnemonicParsing="false">
                <graphic>
                    <HBox alignment="CENTER" spacing="7">
                        <FontIcon iconLiteral="fas-sign-out-alt" iconSize="14" styleClass="nav-logout-icon"/>
                        <Label text="Logout" styleClass="nav-logout-label" mouseTransparent="true"/>
                    </HBox>
                </graphic>
            </Button>

        </HBox>
        <!-- ─── END TOP NAV PANE ──────────────────────────────── -->


        <!-- ═══════════════════════════════════════════════════════
             MASTER CONTENT CARD (remaining ~85%)
        ═══════════════════════════════════════════════════════════ -->
        <StackPane fx:id="masterContentCard"
                   styleClass="dash-content-card"
                   VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="0" right="20" bottom="20" left="20"/>
            </padding>

            <StackPane fx:id="contentArea"
                       styleClass="dash-content-area"
                       alignment="CENTER"
                       maxWidth="Infinity" maxHeight="Infinity">

                <!-- ── Student home (data-driven dashboard) ─── -->
                <ScrollPane fx:id="studentHomeRoot"
                            fitToWidth="true"
                            fitToHeight="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="NEVER"
                            styleClass="assessment-scroll-pane"
                            maxWidth="Infinity" maxHeight="Infinity">

                    <!-- ══════════════════════════════════════════════
                         COORDINATOR-STYLE LAYOUT: identity pane left,
                         data panels right
                    ══════════════════════════════════════════════ -->
                    <HBox spacing="18"
                          styleClass="dashboard-home-root"
                          maxWidth="Infinity" maxHeight="Infinity">
                        <padding><Insets top="24" right="26" bottom="26" left="26"/></padding>


                        <!-- ─────────────────────────────────────────
                             LEFT — Identity pane
                        ───────────────────────────────────────────── -->
                        <VBox fx:id="studentIdentityPane"
                              prefWidth="204" minWidth="180"
                              maxHeight="Infinity"
                              styleClass="dashboard-identity-pane"
                              spacing="0">
                            <padding><Insets top="28" right="20" bottom="24" left="20"/></padding>

                            <!-- Avatar + name + role badge -->
                            <VBox alignment="CENTER" spacing="10">

                                <StackPane styleClass="identity-avatar-circle"
                                           minWidth="72" minHeight="72"
                                           maxWidth="72" maxHeight="72">
                                    <FontIcon iconLiteral="fas-user-graduate"
                                              iconSize="28"
                                              styleClass="identity-avatar-icon"/>
                                </StackPane>

                                <Label fx:id="lblStudentName"
                                       text="—"
                                       styleClass="identity-name-label"
                                       wrapText="false"
                                       maxWidth="164"/>

                                <HBox alignment="CENTER">
                                    <Label text="Student"
                                           styleClass="identity-role-badge"/>
                                </HBox>

                            </VBox>

                            <!-- Separator -->
                            <Separator styleClass="identity-separator">
                                <VBox.margin><Insets top="22" bottom="20"/></VBox.margin>
                            </Separator>

                            <!-- Email detail row -->
                            <HBox alignment="CENTER_LEFT" spacing="9">
                                <FontIcon iconLiteral="fas-envelope"
                                          iconSize="12"
                                          styleClass="identity-detail-icon"/>
                                <Label fx:id="lblStudentEmail"
                                       text="—"
                                       styleClass="identity-detail-label"
                                       wrapText="false"
                                       maxWidth="148"/>
                            </HBox>

                            <!-- Spacer pushes status pill to bottom -->
                            <Region VBox.vgrow="ALWAYS"/>

                            <!-- System online status pill -->
                            <HBox styleClass="system-online-pill"
                                  alignment="CENTER"
                                  spacing="8"
                                  maxWidth="Infinity">
                                <padding><Insets top="9" right="14" bottom="9" left="14"/></padding>
                                <StackPane styleClass="system-online-dot"
                                           minWidth="7" minHeight="7"
                                           maxWidth="7" maxHeight="7"/>
                                <Label text="System Online" styleClass="system-online-label"/>
                            </HBox>

                        </VBox>
                        <!-- ─── END LEFT IDENTITY PANE ────────────── -->


                        <!-- ─────────────────────────────────────────
                             RIGHT — KPI ribbon + data panels
                        ───────────────────────────────────────────── -->
                        <VBox HBox.hgrow="ALWAYS" maxHeight="Infinity" spacing="16">

                            <!-- Welcome header -->
                            <VBox spacing="6" VBox.vgrow="NEVER">
                                <Label fx:id="welcomeLabel"
                                       styleClass="assessment-page-title"
                                       wrapText="true"/>
                                <Label text="Your credits, roadmap progress, readiness, and mentorship at a glance."
                                       styleClass="assessment-page-subtitle"
                                       wrapText="true"/>
                            </VBox>

                            <!-- KPI ribbon -->
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <StackPane styleClass="kpi-icon-pill, kpi-icon-pill-green"
                                                   minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
                                            <FontIcon iconLiteral="fas-coins" iconSize="17" styleClass="kpi-icon kpi-icon-green"/>
                                        </StackPane>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label fx:id="lblKpiCredits" text="—" styleClass="kpi-count-label"/>
                                            <Label text="Credit balance" styleClass="kpi-title-label"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <StackPane styleClass="kpi-icon-pill, kpi-icon-pill-blue"
                                                   minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
                                            <FontIcon iconLiteral="fas-route" iconSize="17" styleClass="kpi-icon kpi-icon-blue"/>
                                        </StackPane>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label fx:id="lblKpiRoadmap" text="—" styleClass="kpi-count-label"/>
                                            <Label text="Roadmap progress" styleClass="kpi-title-label"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <StackPane styleClass="kpi-icon-pill, kpi-icon-pill-amber"
                                                   minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
                                            <FontIcon iconLiteral="fas-chart-line" iconSize="17" styleClass="kpi-icon kpi-icon-amber"/>
                                        </StackPane>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label fx:id="lblKpiReadiness" text="—" styleClass="kpi-count-label"/>
                                            <Label text="Latest readiness" styleClass="kpi-title-label"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <StackPane styleClass="kpi-icon-pill, kpi-icon-pill-green"
                                                   minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
                                            <FontIcon iconLiteral="fas-hands-helping" iconSize="17" styleClass="kpi-icon kpi-icon-green"/>
                                        </StackPane>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label fx:id="lblKpiMentorship" text="—" styleClass="kpi-count-label"/>
                                            <Label text="Mentorship" styleClass="kpi-title-label"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </HBox>
                            <!-- ─── END KPI RIBBON ─────────────────── -->

                            <!-- Two-column: roadmap accordion + right mini panels -->
                            <HBox spacing="16" VBox.vgrow="ALWAYS">

                                <!-- Active Roadmap panel — accordion -->
                                <VBox spacing="12" HBox.hgrow="ALWAYS" maxHeight="Infinity"
                                      styleClass="glass-panel">
                                    <padding><Insets top="18" right="20" bottom="20" left="20"/></padding>

                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <FontIcon iconLiteral="fas-tasks" iconSize="14" styleClass="recent-section-icon"/>
                                        <Label text="Active roadmap" styleClass="glass-card-title"/>
                                    </HBox>
                                    <Separator styleClass="recent-separator"/>

                                    <!-- Empty state -->
                                    <Label fx:id="lblRoadmapEmpty"
                                           text="No approved roadmap yet. When your mentor generates one, your tasks will appear here."
                                           styleClass="assessment-page-subtitle"
                                           wrapText="true"
                                           visible="false" managed="false"/>

                                    <!-- Accordion container — controller builds collapsible cards here -->
                                    <VBox fx:id="roadmapAccordionBox" spacing="10"/>

                                </VBox>

                                <!-- Right mini panels: readiness, mentorship, credits -->
                                <VBox spacing="14" prefWidth="360" minWidth="300" maxWidth="400"
                                      maxHeight="Infinity">

                                    <VBox spacing="10" styleClass="glass-panel">
                                        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                                        <Label text="Readiness" styleClass="glass-card-title"/>
                                        <Label fx:id="lblReadinessEmpty"
                                               text="Run a Readiness Check to see your benchmark score."
                                               styleClass="assessment-page-subtitle" wrapText="true"
                                               visible="false" managed="false"/>
                                        <VBox fx:id="readinessDetailBox" spacing="6">
                                            <Label fx:id="lblReadinessTemplate" styleClass="rg-gap-skill-name" wrapText="true"/>
                                            <Label fx:id="lblReadinessScore" styleClass="kpi-count-label" wrapText="true"/>
                                            <Label fx:id="lblReadinessDate" styleClass="rg-gap-level-text" wrapText="true"/>
                                        </VBox>
                                    </VBox>

                                    <VBox spacing="10" styleClass="glass-panel">
                                        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                                        <Label text="Mentorship" styleClass="glass-card-title"/>
                                        <Label fx:id="lblMentorshipLine1" styleClass="assessment-page-subtitle" wrapText="true"/>
                                        <Label fx:id="lblMentorshipLine2" styleClass="rg-gap-level-text" wrapText="true"/>
                                    </VBox>

                                    <VBox spacing="8" styleClass="recent-activity-panel" VBox.vgrow="ALWAYS">
                                        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                                        <Label text="Recent credit activity" styleClass="recent-panel-title"/>
                                        <Label text="Last five transactions" styleClass="recent-panel-subtitle"/>
                                        <Separator styleClass="recent-separator"/>
                                        <VBox fx:id="creditActivityBox" spacing="8"/>
                                    </VBox>

                                </VBox>

                            </HBox>
                            <!-- ─── END TWO-COLUMN ROW ─────────────── -->

                        </VBox>
                        <!-- ─── END RIGHT PANEL ───────────────────── -->

                    </HBox>

                </ScrollPane>

            </StackPane>

        </StackPane>
        <!-- ─── END MASTER CONTENT CARD ──────────────────────── -->

    </VBox>
    <!-- ─── END LAYOUT SPINE ────────────────────────────────── -->

</StackPane>
