<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  InternshipsView — Manage Internship Templates (UC03)
  Root is a StackPane so the modal overlay sits as a Z-layer above the list.
  The controller wires all list cards and modal rows programmatically.
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           fx:controller="com.example.michiru.InternshipsViewController"
           maxWidth="Infinity" maxHeight="Infinity"
           styleClass="internships-root">

    <!-- ═══════════════════════════════════════════════════════════════════════
         LAYER 0 — Main content: header + scrollable card list
         ═══════════════════════════════════════════════════════════════════════ -->
    <VBox fx:id="mainContentLayer" maxWidth="Infinity" maxHeight="Infinity"
          spacing="0">
        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

        <!-- Page Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Manage Internships" styleClass="page-title"/>
                <Label fx:id="lblSubtitle" text="Loading templates…" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAdd"
                    styleClass="action-btn-primary"
                    onAction="#handleOpenAddModal"
                    mnemonicParsing="false">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <FontIcon iconLiteral="fas-plus" iconSize="13" styleClass="action-btn-icon"/>
                        <Label text="Add New Internship" styleClass="action-btn-label"
                               mouseTransparent="true"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>

        <!-- Subtle separator line -->
        <Separator styleClass="section-divider">
            <VBox.margin><Insets top="18" bottom="18"/></VBox.margin>
        </Separator>

        <!-- Scrollable card list -->
        <ScrollPane fx:id="listScrollPane"
                    fitToWidth="true"
                    styleClass="internship-scroll-pane"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER">
            <VBox fx:id="cardContainer" spacing="10" fillWidth="true">
                <padding><Insets top="2" right="2" bottom="8" left="2"/></padding>
            </VBox>
        </ScrollPane>

    </VBox>


    <!-- ═══════════════════════════════════════════════════════════════════════
         LAYER 1 — Overlay dim pane (sits above the card list)
         Opacity animated 0→1 when modal opens; invisible/non-interactive by default.
         ═══════════════════════════════════════════════════════════════════════ -->
    <Pane fx:id="overlayDim"
          styleClass="overlay-dim"
          maxWidth="Infinity" maxHeight="Infinity"
          mouseTransparent="false"
          visible="false"
          onMouseClicked="#handleOverlayClick"/>


    <!-- ═══════════════════════════════════════════════════════════════════════
         LAYER 2 — Modal host (centred StackPane; contains Add/Edit and Delete modals)
         ═══════════════════════════════════════════════════════════════════════ -->
    <StackPane fx:id="modalHost"
               maxWidth="Infinity" maxHeight="Infinity"
               mouseTransparent="true"
               visible="false">

        <!-- ─── Add / Edit Modal ─────────────────────────────────────────── -->
        <VBox fx:id="formModal"
              styleClass="modal-card"
              maxWidth="580" minWidth="480"
              spacing="0"
              visible="false"
              mouseTransparent="false">

            <!-- Modal Header -->
            <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="20" right="20" bottom="16" left="24"/></padding>
                <FontIcon iconLiteral="fas-briefcase" iconSize="18" styleClass="modal-header-icon"/>
                <Label fx:id="lblModalTitle" text="New Internship" styleClass="modal-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnModalClose"
                        styleClass="modal-close-btn"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false">
                    <graphic>
                        <FontIcon iconLiteral="fas-times" iconSize="14" styleClass="modal-close-icon"/>
                    </graphic>
                </Button>
            </HBox>

            <Separator styleClass="modal-separator"/>

            <!-- Form body -->
            <VBox spacing="14" styleClass="modal-body">
                <padding><Insets top="20" right="24" bottom="0" left="24"/></padding>

                <!-- Name field -->
                <VBox spacing="6">
                    <Label text="Template Name" styleClass="form-field-label"/>
                    <TextField fx:id="fieldName"
                               promptText="e.g. Software Engineering Internship"
                               styleClass="glass-text-field"/>
                </VBox>

                <!-- Description field -->
                <VBox spacing="6">
                    <Label text="Description" styleClass="form-field-label"/>
                    <TextArea fx:id="fieldDesc"
                              promptText="Briefly describe the internship scope and goals…"
                              styleClass="glass-text-area"
                              prefRowCount="3"
                              wrapText="true"/>
                </VBox>

                <!-- Status toggle -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Status" styleClass="form-field-label"/>
                    <ToggleButton fx:id="toggleActive"
                                  text="Active"
                                  selected="true"
                                  styleClass="status-toggle"
                                  onAction="#handleToggleActive"
                                  mnemonicParsing="false"/>
                </HBox>
            </VBox>

            <!-- Skill Requirements section -->
            <VBox spacing="10" styleClass="modal-body">
                <padding><Insets top="18" right="24" bottom="0" left="24"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="1">
                        <Label text="Skill Requirements" styleClass="section-label"/>
                        <Label text="Minimum 3 skills required" styleClass="section-hint"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAddSkillRow"
                            styleClass="add-skill-row-btn"
                            onAction="#handleAddSkillRow"
                            mnemonicParsing="false">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-plus" iconSize="11"
                                          styleClass="add-skill-row-icon"/>
                                <Label text="Add Skill" styleClass="add-skill-row-label"
                                       mouseTransparent="true"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Column headers for skill rows -->
                <HBox styleClass="skill-row-header" spacing="8" alignment="CENTER_LEFT">
                    <padding><Insets left="4"/></padding>
                    <Label text="Skill" styleClass="skill-col-header" prefWidth="220"/>
                    <Label text="Weight" styleClass="skill-col-header" prefWidth="72"/>
                    <Label text="Min. Level" styleClass="skill-col-header" prefWidth="155"/>
                    <Label text="" prefWidth="28"/>
                </HBox>

                <!-- Dynamic skill rows injected by controller -->
                <VBox fx:id="skillRowsContainer" spacing="8">
                    <padding><Insets bottom="4"/></padding>
                </VBox>

            </VBox>

            <!-- Validation error label -->
            <Label fx:id="lblValidationError"
                   text=""
                   styleClass="error-label"
                   wrapText="true"
                   visible="false">
                <VBox.margin><Insets top="10" right="24" left="24"/></VBox.margin>
            </Label>

            <!-- Modal Footer -->
            <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="10">
                <padding><Insets top="16" right="20" bottom="20" left="20"/></padding>
                <Button fx:id="btnCancel"
                        styleClass="modal-cancel-btn"
                        text="Cancel"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false"/>
                <Button fx:id="btnSave"
                        styleClass="action-btn-primary"
                        onAction="#handleSave"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-check" iconSize="12" styleClass="action-btn-icon"/>
                            <Label text="Save Template" styleClass="action-btn-label"
                                   mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

        </VBox>


        <!-- ─── Delete Confirmation Modal ──────────────────────────────── -->
        <VBox fx:id="deleteModal"
              styleClass="modal-card"
              maxWidth="440" minWidth="360"
              spacing="0"
              visible="false"
              mouseTransparent="false">

            <!-- Delete modal header -->
            <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="20" right="20" bottom="16" left="24"/></padding>
                <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="18"
                          styleClass="modal-danger-icon"/>
                <Label text="Delete Internship" styleClass="modal-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="modal-close-btn"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false">
                    <graphic>
                        <FontIcon iconLiteral="fas-times" iconSize="14" styleClass="modal-close-icon"/>
                    </graphic>
                </Button>
            </HBox>

            <Separator styleClass="modal-separator"/>

            <!-- Delete modal body -->
            <VBox spacing="12" styleClass="modal-body">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

                <Label fx:id="lblDeleteTarget"
                       text="Are you sure you want to delete this internship template?"
                       styleClass="delete-confirm-text"
                       wrapText="true"/>

                <!-- Warning shown only if active enrollments exist -->
                <HBox fx:id="enrollmentWarningBox"
                      styleClass="enrollment-warning-box"
                      alignment="CENTER_LEFT"
                      spacing="10"
                      visible="false"
                      managed="false">
                    <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                    <FontIcon iconLiteral="fas-users" iconSize="14" styleClass="warn-icon"/>
                    <Label fx:id="lblEnrollmentWarning"
                           text=""
                           styleClass="warn-label"
                           wrapText="true"
                           HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label text="This action cannot be undone."
                       styleClass="delete-irreversible-text"/>
            </VBox>

            <!-- Delete modal footer -->
            <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="10">
                <padding><Insets top="4" right="20" bottom="20" left="20"/></padding>
                <Button styleClass="modal-cancel-btn"
                        text="Cancel"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false"/>
                <Button fx:id="btnConfirmDelete"
                        styleClass="danger-btn"
                        onAction="#handleConfirmDelete"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-trash-alt" iconSize="12"
                                      styleClass="danger-btn-icon"/>
                            <Label text="Delete" styleClass="danger-btn-label"
                                   mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

        </VBox>

    </StackPane>

</StackPane>
