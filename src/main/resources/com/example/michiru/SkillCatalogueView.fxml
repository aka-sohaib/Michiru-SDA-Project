<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  SkillCatalogueView — Manage Skills (UC02)
  Same three-layer StackPane pattern as InternshipsView.
  Layer 0: header + card list
  Layer 1: overlayDim
  Layer 2: modalHost (form modal + delete modal)
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           fx:controller="com.example.michiru.SkillCatalogueViewController"
           maxWidth="Infinity" maxHeight="Infinity"
           styleClass="internships-root">


    <!-- ═══════════════════════════════════════════════════════════════════════
         LAYER 0 — Main content
         ═══════════════════════════════════════════════════════════════════════ -->
    <VBox fx:id="mainContentLayer" maxWidth="Infinity" maxHeight="Infinity"
          spacing="0">
        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

        <!-- Page header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Skill Catalogue" styleClass="page-title"/>
                <Label fx:id="lblSubtitle" text="Loading skills…" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAdd"
                    styleClass="action-btn-primary"
                    onAction="#handleOpenAddModal"
                    mnemonicParsing="false">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <FontIcon iconLiteral="fas-plus" iconSize="13" styleClass="action-btn-icon"/>
                        <Label text="Add New Skill" styleClass="action-btn-label"
                               mouseTransparent="true"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>

        <Separator styleClass="section-divider">
            <VBox.margin><Insets top="18" bottom="18"/></VBox.margin>
        </Separator>

        <!-- Scrollable card list -->
        <ScrollPane fx:id="listScrollPane"
                    fitToWidth="true"
                    styleClass="internship-scroll-pane"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER">
            <VBox fx:id="cardContainer" spacing="10" fillWidth="true">
                <padding><Insets top="2" right="2" bottom="8" left="2"/></padding>
            </VBox>
        </ScrollPane>

    </VBox>


    <!-- ═══════════════════════════════════════════════════════════════════════
         LAYER 1 — Overlay dim
         ═══════════════════════════════════════════════════════════════════════ -->
    <Pane fx:id="overlayDim"
          styleClass="overlay-dim"
          maxWidth="Infinity" maxHeight="Infinity"
          mouseTransparent="false"
          visible="false"
          onMouseClicked="#handleOverlayClick"/>


    <!-- ═══════════════════════════════════════════════════════════════════════
         LAYER 2 — Modal host
         ═══════════════════════════════════════════════════════════════════════ -->
    <StackPane fx:id="modalHost"
               maxWidth="Infinity" maxHeight="Infinity"
               mouseTransparent="true"
               visible="false">

        <!-- ─── Add / Edit Modal ─────────────────────────────────────────── -->
        <VBox fx:id="formModal"
              styleClass="modal-card"
              maxWidth="540" minWidth="460"
              spacing="0"
              visible="false"
              mouseTransparent="false">

            <!-- Header -->
            <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="20" right="20" bottom="16" left="24"/></padding>
                <FontIcon iconLiteral="fas-star" iconSize="17" styleClass="modal-header-icon"/>
                <Label fx:id="lblModalTitle" text="New Skill" styleClass="modal-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="modal-close-btn"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false">
                    <graphic>
                        <FontIcon iconLiteral="fas-times" iconSize="14" styleClass="modal-close-icon"/>
                    </graphic>
                </Button>
            </HBox>

            <Separator styleClass="modal-separator"/>

            <!-- Form body -->
            <VBox spacing="14" styleClass="modal-body">
                <padding><Insets top="20" right="24" bottom="0" left="24"/></padding>

                <!-- Name -->
                <VBox spacing="6">
                    <Label text="Skill Name" styleClass="form-field-label"/>
                    <TextField fx:id="fieldName"
                               promptText="e.g. Python, Machine Learning, REST APIs…"
                               styleClass="glass-text-field"/>
                </VBox>

                <!-- Category (editable ComboBox) + Difficulty Tier (side by side) -->
                <HBox spacing="14">

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Category" styleClass="form-field-label"/>
                        <ComboBox fx:id="fieldCategory"
                                  editable="true"
                                  promptText="Select or type category…"
                                  styleClass="glass-combo-box"
                                  maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6" minWidth="170">
                        <Label text="Difficulty Tier" styleClass="form-field-label"/>
                        <ComboBox fx:id="fieldDifficulty"
                                  promptText="Select tier…"
                                  styleClass="glass-combo-box"
                                  maxWidth="Infinity"/>
                    </VBox>

                </HBox>

                <!-- Description -->
                <VBox spacing="6">
                    <Label text="Description" styleClass="form-field-label"/>
                    <TextArea fx:id="fieldDesc"
                              promptText="Briefly describe what this skill covers…"
                              styleClass="glass-text-area"
                              prefRowCount="3"
                              wrapText="true"/>
                </VBox>

                <!-- Pass threshold + Status (side by side) -->
                <HBox spacing="14" alignment="CENTER_LEFT">

                    <VBox spacing="6">
                        <Label text="Pass Threshold" styleClass="form-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Spinner fx:id="spinnerPassThreshold"
                                     styleClass="glass-spinner"
                                     prefWidth="82"
                                     editable="true"/>
                            <Label text="questions" styleClass="spinner-unit-label"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Status" styleClass="form-field-label"/>
                        <ToggleButton fx:id="toggleActive"
                                      text="Active"
                                      selected="true"
                                      styleClass="status-toggle, status-toggle-active"
                                      onAction="#handleToggleActive"
                                      mnemonicParsing="false"/>
                    </VBox>

                </HBox>

            </VBox>

            <!-- Validation error label -->
            <Label fx:id="lblValidationError"
                   text=""
                   styleClass="error-label"
                   wrapText="true"
                   visible="false"
                   managed="false">
                <VBox.margin><Insets top="10" right="24" left="24"/></VBox.margin>
            </Label>

            <!-- Footer -->
            <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="10">
                <padding><Insets top="16" right="20" bottom="20" left="20"/></padding>
                <Button fx:id="btnCancel"
                        styleClass="modal-cancel-btn"
                        text="Cancel"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false"/>
                <Button fx:id="btnSave"
                        styleClass="action-btn-primary"
                        onAction="#handleSave"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-check" iconSize="12" styleClass="action-btn-icon"/>
                            <Label text="Save Skill" styleClass="action-btn-label"
                                   mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

        </VBox>


        <!-- ─── Delete / Deactivate Modal ──────────────────────────────── -->
        <VBox fx:id="deleteModal"
              styleClass="modal-card"
              maxWidth="460" minWidth="360"
              spacing="0"
              visible="false"
              mouseTransparent="false">

            <!-- Header -->
            <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="20" right="20" bottom="16" left="24"/></padding>
                <FontIcon fx:id="deleteModalIcon"
                          iconLiteral="fas-exclamation-triangle"
                          iconSize="17"
                          styleClass="modal-danger-icon"/>
                <Label fx:id="lblDeleteModalTitle" text="Delete Skill" styleClass="modal-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="modal-close-btn"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false">
                    <graphic>
                        <FontIcon iconLiteral="fas-times" iconSize="14" styleClass="modal-close-icon"/>
                    </graphic>
                </Button>
            </HBox>

            <Separator styleClass="modal-separator"/>

            <!-- Body -->
            <VBox spacing="12" styleClass="modal-body">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

                <Label fx:id="lblDeleteTarget"
                       styleClass="delete-confirm-text"
                       wrapText="true"/>

                <!-- Dependency info box — shown when skill has linked records -->
                <VBox fx:id="dependencyInfoBox"
                      styleClass="dependency-info-box"
                      spacing="8"
                      visible="false"
                      managed="false">
                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-link" iconSize="13" styleClass="dep-info-icon"/>
                        <Label text="This skill has active dependencies:" styleClass="dep-info-title"/>
                    </HBox>
                    <Label fx:id="lblDependencyInfo"
                           styleClass="dep-info-detail"
                           wrapText="true"/>
                    <Label text="Hard delete is blocked. You can deactivate the skill instead — it will be hidden from new assignments while existing data is preserved."
                           styleClass="dep-info-hint"
                           wrapText="true"/>
                </VBox>

                <Label fx:id="lblDeleteSubtext"
                       styleClass="delete-irreversible-text"
                       wrapText="true"/>
            </VBox>

            <!-- Footer — buttons toggled by controller -->
            <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="10">
                <padding><Insets top="4" right="20" bottom="20" left="20"/></padding>
                <Button styleClass="modal-cancel-btn"
                        text="Cancel"
                        onAction="#handleCloseModal"
                        mnemonicParsing="false"/>
                <!-- Hard delete: shown only when dependency count == 0 -->
                <Button fx:id="btnConfirmHardDelete"
                        styleClass="danger-btn"
                        onAction="#handleConfirmDelete"
                        visible="false"
                        managed="false"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-trash-alt" iconSize="12" styleClass="danger-btn-icon"/>
                            <Label text="Delete" styleClass="danger-btn-label" mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>
                <!-- Deactivate: shown only when dependency count > 0 -->
                <Button fx:id="btnDeactivateSkill"
                        styleClass="deactivate-btn"
                        onAction="#handleDeactivateSkill"
                        visible="false"
                        managed="false"
                        mnemonicParsing="false">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <FontIcon iconLiteral="fas-eye-slash" iconSize="12" styleClass="deactivate-btn-icon"/>
                            <Label text="Deactivate Skill" styleClass="deactivate-btn-label"
                                   mouseTransparent="true"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

        </VBox>

    </StackPane>

</StackPane>
